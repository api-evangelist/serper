{
  "opencollection": "1.0.0",
  "info": {
    "name": "Serper Google Search Autocomplete Places API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Places",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Places Search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://google.serper.dev/places",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Perform a Google Places search returning detailed local business information including addresses, ratings, categories, phone numbers, and websites."
        }
      ]
    }
  ],
  "bundled": true
}